# Server & Runtime Configuration
PORT=8000
NODE_ENV=development

# Database Configuration (Mandatory PostgreSQL in Production / Vercel)
# Local SQLite is used by default if DATABASE_URL is left empty in development.
DATABASE_URL=

# CORS & Security Origins
APP_ORIGIN=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Authentication & Admin Session Security
# ADMIN_JWT_SECRET must be at least 32 cryptographically random characters in production.
ADMIN_JWT_SECRET=

# Staff Bootstrap Credentials (Used during initial db:seed in development)
ADMIN_EMAIL=owner@ochrecoffee.com
ADMIN_PASSWORD=
CASHIER_EMAIL=cashier@ochrecoffee.com
CASHIER_PASSWORD=

# Merchant UPI Information (For QR code generation & direct payments)
UPI_MERCHANT_VPA=9182916879@ybl
UPI_MERCHANT_NAME=Ochre Coffee Roasters

# Razorpay Online Payment Gateway Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Redis Event Bus & Rate Limiting (Optional for multi-instance scaling)
REDIS_URL=

# Safe Destructive-Operation Guards
# When NODE_ENV=production, destructive order reset is completely locked out unless explicitly enabled.
ALLOW_PRODUCTION_ORDER_RESET=false


