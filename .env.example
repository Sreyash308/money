# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
# Leave empty for zero-config local SQLite (data/ochre.db).
# For production (Vercel / Supabase / Neon / Postgres), provide full connection URL:
# DATABASE_URL=postgres://user:password@host:port/database?sslmode=require
DATABASE_URL=

# Razorpay UPI Gateway Credentials
# Replace with your test/live keys from Razorpay Dashboard (Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Destination UPI ID for Merchant Settlements
UPI_MERCHANT_VPA=9182916879@ybl

# Admin & Cashier Authentication
ADMIN_JWT_SECRET=your-random-32-char-jwt-secret-here
ADMIN_EMAIL=owner@ochrecoffee.com
ADMIN_PASSWORD=your-secure-admin-password
CASHIER_EMAIL=cashier@ochrecoffee.com
CASHIER_PASSWORD=your-secure-cashier-password

